{
  "name": "agent-bounty-jobs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate": "wrangler d1 migrations apply agent-bounty-jobs --remote && wrangler d1 migrations apply bounty-queues --remote",
    "migrate:local": "wrangler d1 migrations apply agent-bounty-jobs --local && wrangler d1 migrations apply bounty-queues --local",
    "build:test": "tsc -p tsconfig.json --noEmit false --outDir .test-build",
    "test": "npm run build:test && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.21.0",
    "chess.js": "1.4.0",
    "viem": "^2.57.19",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^3.22.0",
    "solc": "^0.8.28",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
