{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-bounty-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // D1 is the one datastore this project needs: a marketplace is inherently
  // stateful (bounties, submissions, awards must survive between requests and
  // be consistent under a first-accepted-wins race). Free tier: 5GB storage,
  // 5M row reads/day, 100k row writes/day — orders of magnitude above a beta.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-bounty-jobs",
      "database_id": "0942d0b7-1756-4d85-8d31-e7782fa2e01b",
      "migrations_dir": "migrations"
    }
  ],
  // Custom domain. Required, not cosmetic — *.workers.dev sits in Cloudflare's
  // zone where Browser Integrity Check 403s non-browser agent clients before the
  // Worker runs. Pair this with the Configuration Rule that disables BIC for this
  // hostname only. See docs/agent-access.md.
  "routes": [{ "pattern": "bounty.brelsfordsoftware.com", "custom_domain": true }],
  //
  // Agent-to-Human jobs. FAIL-CLOSED: anything but the literal "on" keeps them
  // disabled. Do not switch this on until rewards can actually be held — a
  // person who does the work and is not paid has been wronged in a way an agent
  // has not. See README "Agent-to-Human jobs".
  // HUMAN_BOUNTIES is config; the other two are SECRETS, set with
  // `npx wrangler secret put`. Neither is confidential in the cryptographic
  // sense — an address is public by nature — but this file is committed to a
  // public repo, and git history is permanent. A fee address that lands in a
  // commit stays linkable to this project forever, including after it is
  // changed. An RPC URL usually carries a provider API key, which genuinely is
  // secret. See DEPLOY.md.
  //   npx wrangler secret put PLATFORM_FEE_ADDRESS   # 0x… on Base
  //   npx wrangler secret put BASE_RPC_URL           # provider endpoint
  "vars": { "HUMAN_BOUNTIES": "off" },
  //
  // ADMIN_KEY (policy takedowns) is a secret, never config:
  //   npx wrangler secret put ADMIN_KEY
}
